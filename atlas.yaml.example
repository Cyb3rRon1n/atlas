name: atlas-node
discovery:
  hardware: true
  storage: true
  network: true
inventory:
  directory: inventory/generated
proxmox:
  enabled: false
  host: 192.168.1.10
  user: atlas@pve
  password: ''
  token_name: atlas-token
  token_value: ''
  verify_ssl: false
intelligence:
  provider: anthropic
  model: claude-opus-5
  ollama_host: http://localhost:11434
monitoring:
  enabled: false
  prometheus_url: http://localhost:9090
fleet:
  nodes:
    - name: media-server
      host: 192.168.1.20
      user: atlas
      port: 22
      identity_file: ''
# Posture page (`atlas posture watch`, run by the atlas-scan container). Off by default.
# Needs net.netfilter.nf_conntrack_acct=1 on the host and NET_ADMIN on atlas-scan
# (already in docker-compose.yml) for the read-only conntrack listing.
# posture:
#   enabled: true
#   host_ip: 192.168.1.5              # this host's LAN address
#   gluetun_api_key: ''               # gluetun control-server API key (VPN exit IP check)
#   crowdsec_api_key: ''              # cscli bouncers add atlas
#   traefik_dynamic_dir: /traefik/dynamic   # Traefik file-provider dir, mounted read-only
# Cabling map (`atlas wiring scan`, or Refresh on web /cabling): port-level wired topology
# from your switches over SNMPv3 (read-only, authPriv) and, optionally, a UniFi console.
# Secrets live in the .env file next to docker-compose.yml, never here:
#   ATLAS_SNMP_<NAME>_AUTH / ATLAS_SNMP_<NAME>_PRIV   (<NAME> = switch name, upper-case, - -> _)
#   ATLAS_UNIFI_USER / ATLAS_UNIFI_PASS               (a local, View Only UniFi account)
# Patch panels and wall jacks: copy cabling.example.yaml to cabling.yaml.
# wiring:
#   enabled: true
#   switches:
#     - name: core-switch
#       host: 192.168.1.2
#       priv: aes                       # des for older switches that offer nothing else
#   unifi:
#     enabled: true
#     url: https://192.168.1.1
# Sign-in for the web page: builtin = atlas's own admin password (first visit asks for the
# setup code from `docker compose logs atlas`); proxy = Authelia/Authentik/... in front does it.
web:
  auth: builtin
