name: atlas-node
discovery:
  hardware: true
  storage: true
  network: true
inventory:
  directory: inventory/generated
proxmox:
  enabled: false
  host: 192.168.1.10
  user: atlas@pve
  password: ''
  token_name: atlas-token
  token_value: ''
  verify_ssl: false
intelligence:
  provider: none            # none (default), ollama or anthropic - optional; powers Chat and the daily check-up
  model: claude-opus-5
  ollama_host: http://localhost:11434
monitoring:
  enabled: false
  prometheus_url: http://localhost:9090
fleet:
  nodes:
    - name: media-server
      host: 192.168.1.20
      user: lanxang
      port: 22
      identity_file: ''
# Posture page (`lanxang posture watch`, run by the atlas-scan container). Off by default.
# Needs net.netfilter.nf_conntrack_acct=1 on the host and NET_ADMIN on atlas-scan
# (already in docker-compose.yml) for the read-only conntrack listing.
# posture:
#   enabled: true
#   host_ip: 192.168.1.5              # this host's LAN address
#   gluetun_api_key: ''               # gluetun control-server API key (VPN exit IP check)
#   crowdsec_api_key: ''              # cscli bouncers add lanxang
#   traefik_dynamic_dir: /traefik/dynamic   # Traefik file-provider dir, mounted read-only
# Cabling map (`lanxang wiring scan`, or Refresh on web /cabling): port-level wired topology
# from your switches over SNMPv3 (read-only, authPriv) and, optionally, a UniFi console.
# Secrets live in the .env file next to docker-compose.yml, never here (the old ATLAS_* names still work until 1.2):
#   LANXANG_SNMP_<NAME>_AUTH / LANXANG_SNMP_<NAME>_PRIV   (<NAME> = switch name, upper-case, - -> _)
#   LANXANG_UNIFI_USER / LANXANG_UNIFI_PASS               (a local, View Only UniFi account)
# Patch panels and wall jacks: copy cabling.example.yaml to cabling.yaml.
# wiring:
#   enabled: true
#   switches:
#     - name: core-switch
#       host: 192.168.1.2
#       priv: aes                       # des for older switches that offer nothing else
#   unifi:
#     enabled: true
#     url: https://192.168.1.1
# Alerts (new / offline devices, VPN clients, new sign-in places) go to every channel set here.
# Test with: lanxang notify test. Secrets can live in .env: LANXANG_NTFY_TOKEN, LANXANG_SMTP_PASSWORD.
# notify:
#   ntfy: {url: https://ntfy.sh, topic: my-homelab-a8f3k2}
#   webhooks: [https://discord.com/api/webhooks/123/abc]
#   email: {host: smtp.example.com, port: 587, user: atlas@example.com, to: [me@example.com]}
#   apprise: [tgram://bottoken/ChatID]
# Sign-in for the web page: builtin = Lanxang's own admin password (first visit asks for the
# setup code from `docker compose logs atlas`); proxy = Authelia/Authentik/... in front does it.
web:
  auth: builtin
